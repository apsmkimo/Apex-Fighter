; Engine configuration file.
; 用 Godot 4.4 以上開啟。

config_version=5

[application]

config/name="Apex Fighter"
config/description="Raiden-style vertical shoot 'em up for Android."
run/main_scene="res://src/ui/menus/title_screen.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.png"
config/quit_on_go_back=false

[autoload]

Events="*res://src/autoload/events.gd"
Database="*res://src/autoload/database.gd"
GameManager="*res://src/autoload/game_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="player_bullet"
2d_physics/layer_3="enemy"
2d_physics/layer_4="enemy_bullet"
2d_physics/layer_5="item"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.09, 1)
